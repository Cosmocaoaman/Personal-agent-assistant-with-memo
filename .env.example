# Optional initial configuration. Keys here are plaintext.
# Web settings save keys in the local SQLite database and restore them on restart.
# Environment keys are imported once; saved/cleared database keys take precedence.
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
